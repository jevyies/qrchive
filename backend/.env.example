# ==============================================================================
# QRchive Backend - Environment Variables Template
# Copy this file to .env (for local development) or set these in Railway / production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Networking
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=production
LOG_LEVEL=info

# Comma-separated list of allowed frontend origins (e.g. your Vercel or Railway UI)
# Leave empty or set to '*' to allow all during initial setup
CORS_ORIGIN=https://your-frontend.up.railway.app,http://localhost:5173,http://localhost:3000

# Public URL of this deployed backend (used for R2 image fallbacks & proxies)
BACKEND_PUBLIC_URL=https://your-backend.up.railway.app

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL & Drizzle ORM)
# ------------------------------------------------------------------------------
# On Railway, reference the managed PostgreSQL plugin: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:password@host:5432/railway
DB_SSL=true

# ------------------------------------------------------------------------------
# 3. Redis Cache & Background Queues (BullMQ)
# ------------------------------------------------------------------------------
# On Railway, reference the managed Redis plugin: ${{Redis.REDIS_URL}}
REDIS_URL=redis://default:password@host:6379
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. Authentication & Session Security
# ------------------------------------------------------------------------------
# Minimum 32-character random string for signing JWT tokens and session cookies
JWT_SECRET=generate_a_secure_random_64_char_string_for_jwt
COOKIE_SECRET=generate_a_secure_random_64_char_string_for_cookies

# ------------------------------------------------------------------------------
# 5. Cloudflare R2 Object Storage (Photos, Snaps, & Media)
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=qrchive-2026
# Public custom domain or r2.dev domain (e.g. https://pub-xxx.r2.dev).
# If left empty, backend serves media securely via its built-in proxy endpoints.
R2_PUBLIC_DOMAIN=
R2_ROOT_FOLDER=live

# ------------------------------------------------------------------------------
# 6. Email Service (Google SMTP / Nodemailer for Verification Codes)
# ------------------------------------------------------------------------------
# Create a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

# ------------------------------------------------------------------------------
# 7. OAuth Providers (Optional / As needed)
# ------------------------------------------------------------------------------
# Google OAuth (configured on Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth (configured on GitHub Developer Settings)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=https://your-frontend.up.railway.app/login
